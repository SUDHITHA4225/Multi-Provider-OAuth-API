# Local PostgreSQL settings. Keep DATABASE_URL credentials in sync if these change.
POSTGRES_USER=oauth
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_DB=oauth
DATABASE_URL=postgresql://oauth:replace-with-a-local-database-password@db:5432/oauth?schema=public

# Required: use at least 32 random bytes in production (example: openssl rand -base64 48).
JWT_SECRET=replace-this-with-at-least-32-random-bytes-before-deploying
JWT_ISSUER=multi-provider-oauth
JWT_AUDIENCE=multi-provider-oauth-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# OAuth credentials are optional for startup, but required to sign in with each provider.
# Configure these callback URLs in the corresponding provider console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

PORT=3000
PUBLIC_URL=http://localhost:3000
# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000
